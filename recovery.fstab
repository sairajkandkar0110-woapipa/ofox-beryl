emmc     boot                     /boot         flags=display=emmc
ext4     /dev/block/mmcblk0p4     /cache        flags=display=ext4
ext4 /dev/block/by-name/userdata /data flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption
emmc     misc                     /misc         flags=display=emmc
emmc     recovery                 /recovery     flags=display=emmc
vfat     /dev/block/mmcblk0p6     /sdcard       flags=display=vfat
ext4     /dev/block/mmcblk0p3     /system       flags=display=ext4
